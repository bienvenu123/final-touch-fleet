{
  "expo": {
    "name": "FleetLink",
    "slug": "fleetlink-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "splash": { "resizeMode": "contain", "backgroundColor": "#071b2d" },
    "plugins": ["expo-location", "expo-notifications"],
    "android": { "package": "com.fleetlink.mobile", "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "POST_NOTIFICATIONS"] },
    "ios": { "bundleIdentifier": "com.fleetlink.mobile", "infoPlist": { "NSLocationWhenInUseUsageDescription": "FleetLink uses your location while an assigned trip is active.", "NSUserNotificationsUsageDescription": "FleetLink sends trip and booking updates." } }
  }
}
