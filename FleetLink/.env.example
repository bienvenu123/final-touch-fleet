# API security and database
DATABASE_URL=postgresql://user:password@host:5432/fleetlink
JWT_SECRET=replace-with-a-long-random-production-secret
ENCRYPTION_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
PUBLIC_TENANT_ID=replace-with-public-fleet-tenant-uuid
PUBLIC_API_URL=http://localhost:3000
ENABLE_BACKGROUND_JOBS=false
# Run `npm run worker` as a separate process in production. Set this to true
# only when the API process should also run workers in a small deployment.

# Customer email confirmations (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=FleetLink <notifications@example.com>

# Customer SMS confirmations (Twilio). Telephone numbers submitted on the
# public forms must use international E.164 format, for example +250788123456.
TWILIO_ACCOUNT_SID=replace-with-account-sid
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_PHONE_NUMBER=+15005550006

# Expo push delivery. Device tokens are stored in each user's notification
# preferences. The access token is optional for Expo's basic push service.
EXPO_PUSH_ACCESS_TOKEN=
